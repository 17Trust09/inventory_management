# ─────────────────────────────────────────────────────────────────────────────
# Vorlage für die lokale .env  →  cp .env.example .env
#
# WICHTIG: .env ist per .gitignore ausgeschlossen. Niemals echte Werte committen.
# Alle Werte hier sind Platzhalter und müssen lokal/auf dem Server ersetzt werden.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────────────────────
# Pflicht. 64+ zufällige Zeichen, z.B.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=CHANGE_ME_64_ZUFALLSZEICHEN
DJANGO_DEBUG=false
# Kommasepariert, KEIN Wildcard. Für LAN-Betrieb die konkreten Hosts/IPs eintragen.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Optional: feste Basis-URL für QR-/Deeplinks, z.B. http://server.local:8000
INVENTORY_BASE_URL=

# ── Datenbank ────────────────────────────────────────────────────────────────
# DB_ENGINE=postgres|sqlite|mysql
DB_ENGINE=postgres
POSTGRES_DB=CHANGE_ME_DB_NAME
POSTGRES_USER=CHANGE_ME_DB_USER
# Starkes, zufälliges Passwort. NICHT der Benutzername, kein Wörterbuch-Wort.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
# Nur bei aktivem MySQL-Engine:
# MYSQL_DATABASE=inventorydb
# MYSQL_USER=CHANGE_ME_DB_USER
# MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306

# ── Home Assistant (optional) ────────────────────────────────────────────────
# Long-Lived-Token nur hier bzw. als Container-Env setzen, nie im Repo.
HA_URL=
HA_API_TOKEN=
HA_VERIFY_SSL=true
HA_TIMEOUT=6

# ── Feedback-API (optional) ──────────────────────────────────────────────────
FEEDBACK_API_KEY=

# ── Update-/Tailscale-Helfer (optional) ──────────────────────────────────────
UPDATE_REPO_URL_MAIN=
UPDATE_REPO_URL_DEV=
UPDATE_SERVICE_NAME=
REBOOT_AFTER_UPDATE=false
TAILSCALE_ADMIN_EMAIL=
